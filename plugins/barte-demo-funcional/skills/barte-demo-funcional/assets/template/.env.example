# Copie para .env. Nada aqui é segredo: os emuladores aceitam qualquer
# credencial, e os SDKs exigem alguma.

# ─── a nuvem ────────────────────────────────────────────────────────────────
# aws | gcp | azure — escolhe os adaptadores E o perfil do compose.
# Trocar esta linha troca a demo de nuvem; o código da aplicação é o mesmo.
NUVEM=aws

# ─── AWS (NUVEM=aws) ────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=us-east-1
# Apagar esta linha aponta a demo para a AWS DE VERDADE, com as credenciais do
# seu perfil. É assim que a mesma demo vira um piloto na conta do cliente.
AWS_ENDPOINT_URL=http://127.0.0.1:4566

# ─── Google Cloud (NUVEM=gcp) ───────────────────────────────────────────────
# As bibliotecas do Google leem estas duas sozinhas. Apagar as duas aponta para
# o GCP de verdade, com as credenciais do `gcloud auth application-default`.
GCP_PROJETO=demo-local
STORAGE_EMULATOR_HOST=http://127.0.0.1:4443
PUBSUB_EMULATOR_HOST=127.0.0.1:8085

# ─── Azure (NUVEM=azure) ────────────────────────────────────────────────────
# A conta de desenvolvimento do Azurite — pública e documentada pela Microsoft.
# Trocar por uma connection string de verdade aponta para o Azure.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;QueueEndpoint=http://127.0.0.1:10001/devstoreaccount1

# ─── banco ──────────────────────────────────────────────────────────────────
# Uma URL só, como a aplicação receberia o endereço de uma Aurora, de um Cloud
# SQL ou de um Azure Database — trocar para um banco de verdade é trocar isto.
DATABASE_URL=postgres://demo:demo@127.0.0.1:5432/demo

# ─── o agente ───────────────────────────────────────────────────────────────
#   simulado  determinístico, offline, sem chave — é o padrão, e é o que roda
#             na reunião: mesma entrada, mesmas decisões, sempre.
#   claude    chama a API de verdade (Tool Runner). Exige ANTHROPIC_API_KEY.
#
# Os dois emitem os MESMOS eventos, então a tela não sabe qual está rodando.
AGENTE_MOTOR=simulado
# ANTHROPIC_API_KEY=sk-ant-...

# De onde vem o modelo quando AGENTE_MOTOR=claude:
#   anthropic  a API da Anthropic (padrão)
#   bedrock    o Amazon Bedrock na conta AWS de quem roda — para o cliente que
#              exige que o prompt não saia da nuvem dele. Exige
#              `npm install --workspace @demo/api @anthropic-ai/bedrock-sdk` e o
#              ID do modelo no formato do Bedrock em AGENTE_MODELO.
# AGENTE_PROVEDOR=anthropic
# AGENTE_MODELO=claude-opus-5
