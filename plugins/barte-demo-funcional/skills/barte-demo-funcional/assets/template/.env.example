# Copy to .env. Nothing here is a secret: the emulators accept any credential and
# the SDKs demand one.

# ─── the cloud ──────────────────────────────────────────────────────────────
# aws | gcp | azure — picks the adapters AND the compose profile.
# Changing this line moves the demo between clouds; the application code is the
# same in all three.
CLOUD=aws

# ─── AWS (CLOUD=aws) ────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=us-east-1
# Deleting this line points the demo at REAL AWS, with your profile's
# credentials. That is how the same demo becomes a pilot in the client's account.
AWS_ENDPOINT_URL=http://127.0.0.1:4566

# ─── Google Cloud (CLOUD=gcp) ───────────────────────────────────────────────
# Google's libraries read these on their own. Deleting both points at real GCP,
# with `gcloud auth application-default` credentials.
GCP_PROJECT=demo-local
STORAGE_EMULATOR_HOST=http://127.0.0.1:4443
PUBSUB_EMULATOR_HOST=127.0.0.1:8085

# ─── Azure (CLOUD=azure) ────────────────────────────────────────────────────
# Azurite's development account — public and documented by Microsoft. Swapping it
# for a real connection string points at Azure.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;QueueEndpoint=http://127.0.0.1:10001/devstoreaccount1

# ─── database ───────────────────────────────────────────────────────────────
# One URL, the way the application would receive an Aurora, a Cloud SQL or an
# Azure Database endpoint — pointing at a real database is changing this.
DATABASE_URL=postgres://demo:demo@127.0.0.1:5432/demo

# ─── the agent ──────────────────────────────────────────────────────────────
#   rules   deterministic, offline, no key — the default, and what runs in the
#           meeting: same input, same decisions, every time.
#   claude  calls the real API (Tool Runner). Needs ANTHROPIC_API_KEY.
#
# Both publish the SAME events, so the screen cannot tell which one ran.
AGENT_ENGINE=rules
# ANTHROPIC_API_KEY=sk-ant-...

# Where the model comes from when AGENT_ENGINE=claude:
#   anthropic  the Anthropic API (default)
#   bedrock    Amazon Bedrock in the running account — for the client who requires
#              the prompt to stay in their cloud. Needs
#              `npm install --workspace @demo/api @anthropic-ai/bedrock-sdk` and a
#              Bedrock model id in AGENT_MODEL.
# AGENT_PROVIDER=anthropic
# AGENT_MODEL=claude-opus-5
